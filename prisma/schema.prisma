generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------









// -----------------------------------------------------------------------------
// USER MODULE
// -----------------------------------------------------------------------------

model User {
  id        String        @id @default(uuid())
  name      String?
  username  String        @unique
  email     String        @unique
  password  String?
  phone     String?
  avatarUrl String?
  bio       String?
  role      String @default("USER")
  status    String @default("PUBLISHED")

  locationCityId String?
  locationLat    Float?
  locationLng    Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  wishlists      UserWishlist[]
  visitedTemples UserVisitedTemple[]
  journeys       UserJourney[]
  threads        Thread[]
  comments       Comment[]
  reviews        Review[]
  calendarEvents CalendarEvent[]
  savedFestivals SavedFestival[]
  notifications  Notification[]
  chatSessions   ChatSession[]

  locationCity Region? @relation("UserCity", fields: [locationCityId], references: [id])
}

// -----------------------------------------------------------------------------
// REGION MODULE
// -----------------------------------------------------------------------------

model Region {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  type        String // e.g., COUNTRY, STATE, CITY
  parentId    String?
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  // Relations
  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[] @relation("RegionHierarchy")

  users         User[]   @relation("UserCity")
  templeRegions Temple[] @relation("TempleRegion")
  templeStates  Temple[] @relation("TempleState")
  templeCities  Temple[] @relation("TempleCity")

  festivalOccurrences FestivalOccurrence[]
  festivalRegions     FestivalRegion[]
  pilgrimages         Pilgrimage[]
}

// -----------------------------------------------------------------------------
// DEITY MODULE
// -----------------------------------------------------------------------------

model Deity {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  description   String?
  history       String?
  imageUrl      String?
  parentDeityId String?
  isActive      Boolean @default(true)

  // Relations
  parent   Deity?  @relation("DeityHierarchy", fields: [parentDeityId], references: [id])
  children Deity[] @relation("DeityHierarchy")

  temples       Temple[]      @relation("PrimaryDeity")
  templeDeities TempleDeity[]
  festivals     Festival[]
  pilgrimages   Pilgrimage[]
}

// -----------------------------------------------------------------------------
// TEMPLE MODULE
// -----------------------------------------------------------------------------

model Temple {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  history      String?
  significance String?

  regionId String?
  stateId  String?
  cityId   String?

  latitude      Float?
  longitude     Float?
  googlePlaceId String?
  plusCode      String?

  primaryDeityId String?
  templeType     String?
  templeCategory String? // Storing comma-separated categories

  isMajor    Boolean @default(false)
  isLandmark Boolean @default(false)
  isVerified Boolean @default(false)
  isFeatured Boolean @default(false)

  regularDarshanAvailable Boolean @default(true)
  vipDarshanAvailable     Boolean @default(false)
  darshanBookingUrl       String?

  lastVerifiedAt DateTime?
  sourceName     String?

  bestTimeToVisit      String?
  averageVisitDuration String?

  dressCode          String?
  photographyAllowed Boolean @default(true)
  parkingAvailable   Boolean @default(false)
  wheelchairAccess   Boolean @default(false)

  officialWebsite String?
  officialPhone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  region       Region? @relation("TempleRegion", fields: [regionId], references: [id])
  state        Region? @relation("TempleState", fields: [stateId], references: [id])
  city         Region? @relation("TempleCity", fields: [cityId], references: [id])
  primaryDeity Deity?  @relation("PrimaryDeity", fields: [primaryDeityId], references: [id])

  deities  TempleDeity[]
  darshans DarshanOption[]
  
  festivals   FestivalTemple[]
  events       TempleEvent[]
  pilgrimages  PilgrimageTemple[]
  journeyStops JourneyStop[]

  wishlistedBy UserWishlist[]
  visitedBy    UserVisitedTemple[]

  threads        Thread[]
  reviews        Review[]
  calendarEvents CalendarEvent[]
}

model TempleDeity {
  templeId  String 
  deityId   String 
  isPrimary Boolean @default(false)
  role      String?

  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  deity  Deity  @relation(fields: [deityId], references: [id], onDelete: Cascade)

  @@id([templeId, deityId])
}
model DarshanOption {
  id                 String      @id @default(uuid())
  templeId           String     
  name               String
  type               String
  description        String?
  availability       String?
  bookingRequired    Boolean     @default(false)
  price              Float?
  currency           String?
  officialBookingUrl String?
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  isActive           Boolean     @default(true)

  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// FESTIVAL MODULE
// -----------------------------------------------------------------------------

model Festival {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  significance String?
  history      String?

  deityId             String?
  festivalType        String?
  calendarType        String?
  defaultDurationDays Int     @default(1)
  imageUrl            String?

  isMajor    Boolean @default(false)
  isNational Boolean @default(false)
  isRegional Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deity Deity? @relation(fields: [deityId], references: [id])

  occurrences FestivalOccurrence[]
  temples     FestivalTemple[]
  regions     FestivalRegion[]
  events      TempleEvent[]

  savedBy        SavedFestival[]
  threads        Thread[]
  calendarEvents CalendarEvent[]
}

model FestivalOccurrence {
  id         String  @id @default(uuid())
  festivalId String 
  year       Int
  regionId   String?

  startDate     DateTime 
  endDate       DateTime?
  startDatetime DateTime?
  endDatetime   DateTime?

  calendarSystem    String?
  tithi             String?
  paksha            String?
  nakshatra         String?
  timezone          String?
  calculationMethod String?

  sourceUrl  String?
  verifiedBy String?      
  verifiedAt DateTime?
  status     String @default("PUBLISHED")

  festival Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  region   Region?  @relation(fields: [regionId], references: [id])
}

model FestivalTemple {
  festivalId String
  templeId   String

  importance           Int     @default(1)
  recommendedVisitType String?
  specialEvent         String?
  specialDarshan       String?
  priority             Int     @default(1)
  description          String?
  isFeatured           Boolean @default(false)

  festival Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  temple   Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@id([festivalId, templeId])
}

model FestivalRegion {
  festivalId String
  regionId   String

  importance       Int     @default(1)
  localName        String?
  localDescription String?
  celebrationLevel String?

  festival Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  region   Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([festivalId, regionId])
}

model TempleEvent {
  id         String  @id @default(uuid())
  templeId   String 
  festivalId String?

  name        String
  description String?

  startDatetime DateTime
  endDatetime   DateTime?

  eventType       String?
  specialDarshan  String?
  bookingRequired Boolean @default(false)
  bookingUrl      String?

  sourceUrl  String?
  verifiedAt DateTime?
  status     String @default("PUBLISHED")

  temple   Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  festival Festival? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  calendarEvents CalendarEvent[]
}

// -----------------------------------------------------------------------------
// PILGRIMAGE MODULE
// -----------------------------------------------------------------------------

model Pilgrimage {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  deityId  String?
  regionId String?

  durationDays Int?
  difficulty   String?

  isOfficial Boolean @default(false)
  isFeatured Boolean @default(false)
  imageUrl   String?

  deity  Deity?  @relation(fields: [deityId], references: [id])
  region Region? @relation(fields: [regionId], references: [id])

  temples      PilgrimageTemple[]
  userJourneys UserJourney[]
  threads      Thread[]
}

model PilgrimageTemple {
  pilgrimageId String
  templeId     String

  sequence            Int
  recommendedDuration String?
  dayNumber           Int?
  notes               String?
  isMandatory         Boolean @default(true)

  pilgrimage Pilgrimage @relation(fields: [pilgrimageId], references: [id], onDelete: Cascade)
  temple     Temple     @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@id([pilgrimageId, templeId])
}

// -----------------------------------------------------------------------------
// USER CONTENT MODULE
// -----------------------------------------------------------------------------

model UserJourney {
  id           String  @id @default(uuid())
  userId       String 
  pilgrimageId String?

  name      String
  startDate DateTime?
  endDate   DateTime?

  status   String @default("PLANNED")
  progress Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilgrimage Pilgrimage? @relation(fields: [pilgrimageId], references: [id], onDelete: SetNull)

  calendarEvents CalendarEvent[]
  stops          JourneyStop[]
}

model JourneyStop {
  id            String  @id @default(uuid())
  userJourneyId String
  templeId      String

  sequence    Int
  notes       String?
  isCompleted Boolean @default(false)
  completedAt DateTime?

  userJourney UserJourney @relation(fields: [userJourneyId], references: [id], onDelete: Cascade)
  temple      Temple      @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userJourneyId, sequence])
}

// -----------------------------------------------------------------------------
// AI ASSISTANT MODULE
// -----------------------------------------------------------------------------

model ChatSession {
  id        String   @id @default(uuid())
  userId    String?  // Optional for anonymous users
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ChatMessage {
  id            String   @id @default(uuid())
  chatSessionId String
  role          String   // "USER", "ASSISTANT", "SYSTEM"
  content       String
  toolCalls     String?  // JSON string
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

model UserVisitedTemple {
  id       String @id @default(uuid())
  userId   String
  templeId String

  visitedAt DateTime?
  notes     String?
  rating    Int?
  photoUrl  String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model UserWishlist {
  id       String @id @default(uuid())
  userId   String
  templeId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userId, templeId])
}

// -----------------------------------------------------------------------------
// COMMUNITY MODULE
// -----------------------------------------------------------------------------

model Thread {
  id     String @id @default(uuid())
  userId String

  templeId     String?
  festivalId   String?
  pilgrimageId String?

  title   String
  content String
  status  String @default("PUBLISHED")

  viewCount  Int @default(0)
  replyCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple     Temple?     @relation(fields: [templeId], references: [id])
  festival   Festival?   @relation(fields: [festivalId], references: [id])
  pilgrimage Pilgrimage? @relation(fields: [pilgrimageId], references: [id])

  comments Comment[]
}

model Comment {
  id              String  @id @default(uuid())
  threadId        String 
  userId          String 
  parentCommentId String?

  content String
  status  String @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread        Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentToComment", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentToComment")
}

model Review {
  id       String @id @default(uuid())
  userId   String
  templeId String

  rating    Int
  title     String?
  content   String?
  visitDate DateTime?    
  status    String @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// PERSONAL CALENDAR & NOTIFICATIONS
// -----------------------------------------------------------------------------

model CalendarEvent {
  id     String @id @default(uuid())
  userId String
  type   String // FESTIVAL, JOURNEY, TEMPLE_EVENT

  festivalId    String?
  templeId      String?
  journeyId     String?
  templeEventId String?

  title       String
  description String?

  startDatetime DateTime
  endDatetime   DateTime?

  reminderEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  festival    Festival?    @relation(fields: [festivalId], references: [id])
  temple      Temple?      @relation(fields: [templeId], references: [id])
  journey     UserJourney? @relation(fields: [journeyId], references: [id])
  templeEvent TempleEvent? @relation(fields: [templeEventId], references: [id])
}

model SavedFestival {
  userId           String  
  festivalId       String  
  notifyBeforeDays Int      @default(7)
  createdAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  festival Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@id([userId, festivalId])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  type   String // SYSTEM, FESTIVAL_REMINDER, NEW_COMMENT, etc.

  title   String
  message String

  entityType String?
  entityId   String?

  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  status      String    @default("PENDING")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// VERIFICATION MODULE
// -----------------------------------------------------------------------------

model ContentSource {
  id String @id @default(uuid())

  entityType String
  entityId   String    

  sourceType String // OFFICIAL_TEMPLE, GOVERNMENT, USER_SUBMISSION, etc.
  sourceName String
  sourceUrl  String?

  verifiedAt         DateTime?
  verifiedBy         String?      
  verificationStatus String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

